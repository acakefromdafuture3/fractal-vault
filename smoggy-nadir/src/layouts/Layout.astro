---
import '../styles/global.css';

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Fractal Vault - Zero Knowledge Security" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<title>{title}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Geist:wght@100..900&family=JetBrains+Mono:ital,wght@0,100..800;1,100..800&display=swap" rel="stylesheet">
	</head>
	<body class="bg-[#0A0E14] text-white selection:bg-cyan-500/30 font-sans relative">
		<!-- Global grid pattern overlay -->
		<div class="pointer-events-none fixed inset-0 z-[1] opacity-[0.04]" style="background-image: linear-gradient(rgba(94,243,220,0.4) 1px, transparent 1px), linear-gradient(90deg, rgba(94,243,220,0.4) 1px, transparent 1px); background-size: 48px 48px;"></div>

		<!-- CRT scanline overlay -->
		<div class="pointer-events-none fixed inset-0 z-[2] scanlines"></div>

		<!-- Subtle vignette -->
		<div class="pointer-events-none fixed inset-0 z-[1]" style="background: radial-gradient(ellipse at center, transparent 60%, rgba(0,0,0,0.55) 100%);"></div>

		<div class="relative z-[3]">
			<slot />
		</div>
	</body>
</html>

<style is:global>
	:root {
		--accent-gradient: linear-gradient(45deg, #5EF3DC, #2D46FF);
	}
	html {
		font-family: 'Geist', sans-serif;
	}
	code {
		font-family: 'JetBrains Mono', monospace;
	}

	/* CRT scanline effect */
	.scanlines {
		background: repeating-linear-gradient(
			to bottom,
			rgba(255, 255, 255, 0) 0px,
			rgba(255, 255, 255, 0) 2px,
			rgba(94, 243, 220, 0.025) 3px,
			rgba(0, 0, 0, 0.02) 4px
		);
		mix-blend-mode: overlay;
		animation: scanline-drift 12s linear infinite;
	}

	@keyframes scanline-drift {
		0% { background-position: 0 0; }
		100% { background-position: 0 100px; }
	}

	/* Generic glow utilities */
	.text-glow-cyan {
		text-shadow: 0 0 12px rgba(94, 243, 220, 0.6), 0 0 30px rgba(94, 243, 220, 0.25);
	}
	.text-glow-red {
		text-shadow: 0 0 12px rgba(248, 113, 113, 0.6), 0 0 30px rgba(248, 113, 113, 0.25);
	}
	.text-glow-green {
		text-shadow: 0 0 12px rgba(74, 222, 128, 0.6), 0 0 30px rgba(74, 222, 128, 0.25);
	}

	/* Flicker animation for terminal-esque accents */
	@keyframes flicker {
		0%, 100% { opacity: 1; }
		45% { opacity: 1; }
		46% { opacity: 0.4; }
		47% { opacity: 1; }
		48% { opacity: 0.6; }
		49% { opacity: 1; }
	}
	.flicker {
		animation: flicker 6s infinite;
	}
</style>
